{
  "scripts": {
    "build": "npm run build:spacetime-client",
    "build:spacetime-client": "esbuild client/spacetime-client.ts --bundle --format=iife --global-name=PlanningCardsSpacetimeBundle --outfile=spacetime-client.js",
    "generate:spacetime": "spacetime generate --lang typescript --module-path spacetimedb --out-dir client/module_bindings --yes",
    "screenshots": "node scripts/capture-readme-screenshots.js",
    "test": "playwright test"
  },
  "dependencies": {
    "spacetimedb": "2.8.*"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "esbuild": "^0.25.10",
    "typescript": "~5.6.2"
  }
}
